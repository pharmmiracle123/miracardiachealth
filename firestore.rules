rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

function isSignedIn() {
return request.auth != null;
}
function hasUserDoc() {
return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
}
function userDoc() {
return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}
function isRole(role) {
return hasUserDoc() && userDoc().role == role;
}

function adminEmails() {
  // Primary admins + three additional. Edit this list in Firebase Console → Firestore → Rules if you need more.
  return [
    'onyekamiracle08@gmail.com',
    'onyekaudechukwum@gmail.com',
    'onyekamiracle08@yahoo.com',
    'onyekaudechukwum@yahoo.com',
    'admin@miracardiachealth.com'
  ];
}
function isAdminEmail() {
  // Allows listed emails to become admin. email_verified preferred but not required
  // so first-time Google / email login works even before verification is clicked.
  return isSignedIn()
    && 'email' in request.auth.token
    && request.auth.token.email.lower() in adminEmails();
}
function isAdmin() {
  return isAdminEmail() || isRole('admin');
}

function isDoctor() {
return isRole('doctor');
}
function isPharmacist() {
return isRole('pharmacist');
}
function isSupport() {
return isRole('support');
}
function isOwner(userId) {
return isSignedIn() && request.auth.uid == userId;
}

match /users/{userId} {
  allow read: if isSignedIn() && (isOwner(userId) || isAdmin() || isSupport());

  // Public self-signup: patient only (active or pending)
  // Staff roles may be created as pending by the owner (secondary-app flow)
  // Admin may create any user document (staff onboarding)
  allow create: if
    (isOwner(userId) && (
      (request.resource.data.role == 'patient' && request.resource.data.status in ['active', 'pending'])
      || (request.resource.data.role in ['doctor', 'pharmacist', 'support', 'nurse', 'surgeon', 'lab', 'radiologist', 'counselor', 'anaesthetist']
          && request.resource.data.status == 'pending')
    ))
    || isAdmin()
    || (isAdminEmail() && request.resource.data.role == 'admin' && request.resource.data.status == 'active');

  // Owner can edit own non-role fields; admin (or admin-email) can change anything including role
  allow update: if (isOwner(userId)
      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isAdmin']))
    || isAdmin()
    || (isAdminEmail() && isOwner(userId));

  allow delete: if isAdmin();
}

match /doctors/{doctorId} {
allow read: if true;
allow create: if (isOwner(doctorId) && request.resource.data.status == 'pending') || isAdmin();
allow update: if (isOwner(doctorId)
&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified']))
|| isAdmin();
allow delete: if isAdmin();
}

match /pharmacies/{pharmacyId} {
allow read: if true;
allow create: if isSignedIn() && (isPharmacist() || isAdmin())
&& request.resource.data.status == 'pending';
allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid
&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified']))
|| isAdmin();
allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

match /drugs/{drugId} {
allow read: if true;
allow create, update, delete: if isSignedIn()
&& (get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerId == request.auth.uid
|| isAdmin());
}
}

function isConsultParticipant() {
  return isSignedIn() && (
    resource.data.patientId == request.auth.uid
    || resource.data.doctorId == request.auth.uid
    || ('doctorEmail' in resource.data
        && request.auth.token.email != null
        && resource.data.doctorEmail == request.auth.token.email.lower())
    || isAdmin()
  );
}

match /consultations/{consultId} {
  allow read: if isConsultParticipant();

  // Paid consults OR direct MIRACARDIAC HEALTH CHAT (status active + type direct)
  allow create: if isSignedIn()
    && request.resource.data.patientId == request.auth.uid
    && (
      request.resource.data.status == 'paid_pending'
      || (request.resource.data.status == 'active' && request.resource.data.type == 'direct')
    );

  allow update: if isConsultParticipant();

  match /messages/{msgId} {
    function consultData() {
      return get(/databases/$(database)/documents/consultations/$(consultId)).data;
    }
    function canAccessConsult() {
      return isSignedIn() && (
        consultData().patientId == request.auth.uid
        || consultData().doctorId == request.auth.uid
        || ('doctorEmail' in consultData()
            && request.auth.token.email != null
            && consultData().doctorEmail.lower() == request.auth.token.email.lower())
        || isAdmin()
      );
    }
    allow read: if canAccessConsult();
    allow create: if isSignedIn()
      && request.resource.data.senderId == request.auth.uid
      && canAccessConsult()
      && (
        consultData().status == 'active'
        || consultData().type == 'direct'
      );
    allow update: if isSignedIn() && (
      (resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId)
      // the OTHER participant (doctor/patient) may only set read receipts
      || (canAccessConsult()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']))
    );
    allow delete: if isAdmin()
      || (isSignedIn() && resource.data.senderId == request.auth.uid);
  }
}

match /appointments/{apptId} {
allow read: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.doctorId == request.auth.uid
|| isAdmin() || isSupport());
allow create: if isSignedIn()
&& (request.resource.data.patientId == request.auth.uid || isSupport() || isAdmin());
allow update: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.doctorId == request.auth.uid
|| isAdmin() || isSupport());
allow delete: if isAdmin();
}

match /availability/{docId} {
allow read: if true;
allow create: if isSignedIn()
&& (request.resource.data.doctorId == request.auth.uid || isAdmin());
allow update: if isSignedIn()
&& (resource.data.doctorId == request.auth.uid || isAdmin());
allow delete: if isAdmin() || (isSignedIn() && resource.data.doctorId == request.auth.uid);
}

match /slotLocks/{lockId} {
allow read: if isSignedIn();
allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
allow delete: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.doctorId == request.auth.uid
|| isAdmin());
allow update: if isAdmin();
}

match /orders/{orderId} {
allow read: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.pharmacyOwnerId == request.auth.uid
|| isAdmin());
allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
allow update: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.pharmacyOwnerId == request.auth.uid
|| isAdmin());
allow delete: if isAdmin();
}

match /prescriptions/{rxId} {
allow read: if isSignedIn() && (
resource.data.patientId == request.auth.uid
|| resource.data.doctorId == request.auth.uid
|| isAdmin()
|| (isPharmacist() && resource.data.pharmacyId != null));
allow create: if isSignedIn() && (isDoctor() || isAdmin());
allow update: if isSignedIn() && (resource.data.doctorId == request.auth.uid || isAdmin());
allow delete: if isAdmin();
}

match /payments/{payId} {
allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
allow create, update, delete: if isAdmin();
}

match /supportTickets/{ticketId} {
allow read: if isSignedIn() && (
resource.data.userId == request.auth.uid || isSupport() || isAdmin());
allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
allow update: if isSignedIn() && (
resource.data.userId == request.auth.uid || isSupport() || isAdmin());

match /messages/{msgId} {
allow read, create: if isSignedIn() && (
get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
|| isSupport() || isAdmin());
}
}

match /tickets/{ticketId} {
allow read: if isSignedIn() && (
resource.data.userId == request.auth.uid || isSupport() || isAdmin());
allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
allow update: if isSignedIn() && (
resource.data.userId == request.auth.uid || isSupport() || isAdmin());
}

match /callbacks/{cbId} {
allow read: if isSupport() || isAdmin();
allow create: if isSignedIn();
allow update: if isSupport() || isAdmin();
allow delete: if isAdmin();
}

match /reviews/{reviewId} {
allow read: if true;
allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
allow update, delete: if isSignedIn() && (
resource.data.patientId == request.auth.uid || isAdmin());
}

match /notifications/{notifId} {
allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
allow create: if isAdmin() || isSupport() || isDoctor();
allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
}

match /announcements/{annId} {
allow read: if true;
allow write: if isAdmin();
}

match /settings/{docId} {
allow read: if true;
allow write: if isAdmin();
}

match /studentCourses/{courseId} {
allow read: if true;
allow create, update, delete: if isAdmin();

match /questions/{questionId} {
allow read: if isSignedIn();
allow create, update, delete: if isAdmin();
}
}

match /studentPurchases/{purchaseId} {
allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
allow update, delete: if isAdmin();
}

match /studentAccess/{accessId} {
allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
allow create, update, delete: if isAdmin();
}

// ========== Full Hospital Management System collections ==========
// Staff (any signed-in clinical/admin role) can read/write operational data.
// Tighten further in production as needed.

function isClinicalStaff() {
  return isSignedIn() && (
    isAdmin() || isDoctor() || isPharmacist() || isSupport() ||
    isRole('nurse') || isRole('surgeon') || isRole('lab') ||
    isRole('radiologist') || isRole('anaesthetist') || isRole('counselor')
  );
}

match /emr/{patientId} {
  allow read: if isClinicalStaff() || (isSignedIn() && request.auth.uid == patientId);
  allow create, update: if isClinicalStaff();
  allow delete: if isAdmin();
}

match /beds/{bedId} {
  allow read: if isSignedIn();
  allow write: if isClinicalStaff();
}

match /admissions/{id} {
  allow read, write: if isClinicalStaff();
}

match /otCases/{id} {
  allow read, write: if isClinicalStaff();
}

match /mar/{id} {
  allow read, write: if isClinicalStaff();
}

match /carePlans/{id} {
  allow read, write: if isClinicalStaff();
}

match /handovers/{id} {
  allow read, write: if isClinicalStaff();
}

match /nurseTasks/{id} {
  allow read, write: if isClinicalStaff();
}

match /labOrders/{id} {
  allow read, write: if isClinicalStaff();
}

match /imagingOrders/{id} {
  allow read, write: if isClinicalStaff();
}

match /pathologyOrders/{id} {
  allow read, write: if isClinicalStaff();
}

match /edEncounters/{id} {
  allow read, write: if isClinicalStaff();
}

match /counselingSessions/{id} {
  allow read, write: if isClinicalStaff();
}

match /invoices/{id} {
  allow read, write: if isClinicalStaff();
}

match /inventoryItems/{id} {
  allow read: if isSignedIn();
  allow write: if isClinicalStaff();
}

match /incidents/{id} {
  allow read, write: if isClinicalStaff();
}

match /discharges/{id} {
  allow read, write: if isClinicalStaff();
}

match /referrals/{id} {
  allow read, write: if isClinicalStaff();
}

match /staffDirectory/{id} {
  allow read: if isSignedIn();
  allow write: if isAdmin() || isClinicalStaff();
}


match /doctorPresence/{emailId} {
  allow read: if true;
  // Doctors update their own presence doc (doc id = email slug or uid)
  allow create, update: if isSignedIn()
    && request.resource.data.email is string
    && request.resource.data.email.lower() == request.auth.token.email.lower();
  allow delete: if isAdmin();
}

match /{document=**} {
allow read, write: if false;
}
}
}